# cf-webhook local / dashboard variable template
# Cloudflare: copy to .dev.vars for `wrangler dev`
# Dashboard: Settings → Variables and Secrets
#
# Variable names and enum values are case-insensitive (tgbot/TGBOT).
# Token, chat id, URL, timezone, IP keep original case.

# --- receive ---

# Comma-separated IPs for POST / only. Empty / unset = allow all.
# WHITE_IPs=1.2.3.4,5.6.7.8
WHITE_IPS=

# IANA timezone. Set a valid zone to append a timestamp; empty / invalid = off.
# TIME_MARKER=Asia/Shanghai
TIME_MARKER=

# --- forward ---

# Which channel(s) to use. Default: tgbot
# Accepted: tgbot | webhook | all
FORWARD_PATH=tgbot

# Telegram bot: token,admin_id[,id2,id3...]
# First chat id = admin (can use /webhook). All ids receive messages.
# Required when FORWARD_PATH is tgbot or all.
# Alias (still accepted): TELEGRAM_BOT
FORWARD_PATH_TGBOT=123456:AAF-xxxx,111111111

# Downstream webhook URL. POST the same body. https and http are both accepted.
# Required when FORWARD_PATH is webhook or all.
# FORWARD_PATH_WEBHOOK=https://example.com/incoming
FORWARD_PATH_WEBHOOK=
