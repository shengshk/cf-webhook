# GitHub export whitelist (gitignore-style). Unlisted paths stay off origin.
# Gitea still receives these files. README.PUBLIC.md is renamed to README.md on GitHub.

.gitignore
LICENSE
README.PUBLIC.md -> README.md
.env.example
.files2github
package.json
bun.lock
tsconfig.json
wrangler.jsonc
esbuild.config.js
html.d.ts
src/
docs/
build/
